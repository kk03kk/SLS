if(NOT DEFINED ZIG_EXECUTABLE)
    if(DEFINED ENV{ZIG_EXECUTABLE})
        set(ZIG_EXECUTABLE "$ENV{ZIG_EXECUTABLE}")
    else()
        message(FATAL_ERROR "Set ZIG_EXECUTABLE to zig.exe")
    endif()
endif()
file(TO_CMAKE_PATH "${ZIG_EXECUTABLE}" ZIG_EXECUTABLE)

set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_CXX_COMPILER "${ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER_ARG1 "c++")
set(CMAKE_CXX_COMPILER_TARGET "x86_64-windows-gnu")
set(CMAKE_RC_COMPILER "${ZIG_EXECUTABLE}")
set(CMAKE_RC_COMPILER_ARG1 "rc")
