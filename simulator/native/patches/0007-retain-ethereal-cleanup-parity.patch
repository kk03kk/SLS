+Action Actions::RetainCardsAction(int count) {
+    return {[=] (BattleContext &bc) {
+        if (count <= 0 || bc.cards.cardsInHand <= 0 ||
+                bc.player.hasRelic<R::RUNIC_PYRAMID>() ||
+                bc.player.hasStatus<PS::EQUILIBRIUM>()) {
+            return;
+        }
+        bc.inputState = InputState::CARD_SELECT;
+        bc.cardSelectInfo.cardSelectTask = CardSelectTask::RETAIN_CARDS;
+        bc.cardSelectInfo.pickCount = std::min(count, bc.cards.cardsInHand);
+        bc.cardSelectInfo.canPickAnyNumber = true;
+        bc.cardSelectInfo.canPickZero = true;
+    }};
+}
