+void BattleContext::chooseRetainCards(const fixed_list<int, 10> &idxs) {
+    for (const auto handIdx : idxs) {
+        if (handIdx >= 0 && handIdx < cards.cardsInHand &&
+                !cards.hand[handIdx].isEthereal()) {
+            cards.hand[handIdx].retain = true;
+        }
+    }
+}
